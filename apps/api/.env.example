# Database URL for the app (using connection pooling port 6543 with pgbouncer=true, Transaction mode)
DATABASE_URL="postgres://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for running migrations (using direct connection port 5432, Session mode)
DIRECT_URL="postgres://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:5432/postgres"

# API Port
PORT=3000
