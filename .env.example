# Database Connection Strings (from Supabase Database Settings)
# -------------------------------------------------------------
# 1. DATABASE_URL: Used by the application and Prisma client queries. 
#    - Port: 6543 (Connection Pooler - Transaction Mode)
#    - Appended with: ?pgbouncer=true
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-ID]:[YOUR-DB-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Used by Prisma to perform migrations and DB pushes.
#    - Port: 5432 (Direct connection - Session Mode)
#    - Note: No pgbouncer suffix
DIRECT_URL="postgres://postgres.[YOUR-PROJECT-ID]:[YOUR-DB-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"
